{
    "name": "laranail/crm-tools-zoho-oauth",
    "description": "Zoho OAuth token management for Laravel.",
    "keywords": [
        "api",
        "zoho",
        "oauth"
    ],
    "homepage": "https://opensource.simtabi.com/products/laranail/crm-tools-zoho-oauth",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Imani Manyara",
            "email": "imani@simtabi.com"
        }
    ],
    "require": {
        "php": "^8.4.1 || ^8.5",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/support": "^13.0",
        "laranail/package-tools": "^0.1"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^4.6 || ^5.0",
        "phpunit/phpunit": ">=9.0"
    },
    "autoload": {
        "psr-4": {
            "Simtabi\\Laranail\\CrmTools\\ZohoOAuth\\": "src",
            "Simtabi\\Laranail\\CrmTools\\ZohoOAuth\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simtabi\\Laranail\\CrmTools\\ZohoOAuth\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "pint": "@php vendor/bin/laranail-pint --test",
        "pint-fix": "@php vendor/bin/laranail-pint --parallel",
        "format": "@pint-fix",
        "lint": [
            "@pint"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simtabi\\Laranail\\CrmTools\\ZohoOAuth\\Providers\\ZohoOAuthServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/laranail/crm-tools-zoho-oauth/issues",
        "source": "https://github.com/laranail/crm-tools-zoho-oauth",
        "docs": "https://opensource.simtabi.com/documentation/laranail/crm-tools-zoho-oauth/"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/laranail/package-tools"
        },
        {
            "type": "composer",
            "url": "https://repo.packagist.org",
            "exclude": [
                "laranail/*"
            ]
        },
        {
            "packagist.org": false
        }
    ]
}
