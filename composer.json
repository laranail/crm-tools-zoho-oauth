{
  "name": "usipcom/laravel-zoho-oauth",
  "description": "Generate Zoho API access and refresh token in Laravel 9.0 and up projects",
  "keywords": [
    "api",
    "zoho",
    "oauth"
  ],
  "homepage": "https://github.com/usipcom/laravel-zoho-oauth",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Imani Manyara",
      "homepage": "imanimanyara.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.0",
    "guzzlehttp/guzzle": "^7.2",
    "illuminate/support": ">=9.0"
  },
  "require-dev": {
    "orchestra/testbench": ">=6.0",
    "phpunit/phpunit": ">=9.0"
  },
  "autoload": {
    "psr-4": {
      "USIPCOM\\ZohoOAuth\\": "src",
      "USIPCOM\\ZohoOAuth\\Database\\Factories\\": "database/factories"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "USIPCOM\\ZohoOAuth\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "USIPCOM\\ZohoOAuth\\Providers\\ZohoOAuthServiceProvider"
      ]
    }
  },
    "minimum-stability": "dev",
    "prefer-stable": true
}
